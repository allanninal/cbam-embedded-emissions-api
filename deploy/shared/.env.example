# Copy to deploy/shared/.env on the server (never commit). Used by the SHARED
# edge (Caddy), gateway (APISIX), and Redis — started once for the whole server.

# Redis password for the shared rate-limit store. Generate: openssl rand -hex 24
# This MUST be the SAME value every project's .env uses (dpp, cbam, c2pa, eudr).
REDIS_PASSWORD=change-me-to-a-long-random-secret

# Public entry address for the shared Caddy edge.
#   - Leave unset (or ":80") to serve HTTP on the bare IP (pre-domain).
#   - Set to a domain (e.g. apis.example.com) to enable automatic HTTPS
#     (Let's Encrypt) once DNS points at this server.
#
# SET THIS ONCE YOU HAVE A DOMAIN, and set it HERE — this file is the only env
# the shared compose reads (docker compose resolves .env from the compose file's
# directory, NOT from the repo root). If it is missing, Caddy is recreated with
# SITE_ADDRESS=:80 and HTTPS silently disappears on the next shared deploy, even
# though the certificate is still sitting in the caddy-data volume. The symptom
# is every https:// URL timing out while http:// keeps returning 200.
SITE_ADDRESS=apis.example.com
