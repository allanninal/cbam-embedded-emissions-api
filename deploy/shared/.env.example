# Copy to deploy/shared/.env on the server (never commit). Used by the SHARED
# edge (Caddy), gateway (APISIX), and Redis — started once for the whole server.

# Redis password for the shared rate-limit store. Generate: openssl rand -hex 24
# This MUST be the SAME value every project's .env uses (cbam, c2pa, eudr).
REDIS_PASSWORD=change-me-to-a-long-random-secret

# Public entry address for the shared Caddy edge.
#   - Leave unset (or ":80") to serve HTTP on the bare IP (pre-domain).
#   - Set to a domain (e.g. apis.example.com) to enable automatic HTTPS
#     (Let's Encrypt) once DNS points at this server.
# SITE_ADDRESS=apis.example.com
