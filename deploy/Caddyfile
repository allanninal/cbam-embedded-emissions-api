# Shared edge (TLS + safety) in front of the shared API gateway.
#
#   Internet -> Caddy (TLS, body cap, real client IP) -> APISIX (routing,
#   rate limiting, CORS, per-project routes) -> project API containers.
#
# Caddy forwards the FULL path (e.g. /dpp/...) to APISIX, which owns routing and
# strips the project prefix per route. New projects are added in APISIX
# (deploy/shared/apisix/apisix.yaml), not here — this file just forwards each
# known prefix to the gateway.
#
# This is the AUTHORITATIVE shared edge config, kept identical across all project
# repos (dpp / cbam / c2pa / eudr). Whichever repo is deployed serves the same
# landing page + forwards the same prefixes. Edit once, copy to the sibling repos.
#
# TLS: set SITE_ADDRESS to a domain (e.g. apis.example.com) in .env and Caddy
# provisions a Let's Encrypt certificate automatically. Left unset it defaults to
# :80 (bare-IP HTTP) for pre-domain deployments.

(project_routes) {
	encode gzip

	# --- Security headers + banner stripping (applied to every response) ---
	header {
		# HSTS: force HTTPS for 1 year incl. subdomains. Safe once TLS is live.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Stop MIME sniffing, deny framing, limit referrer + powerful features.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		# Remove software/version banners that aid targeted attacks.
		-Server
		-X-Powered-By
		defer
	}

	# --- Block raw source/config files from ever being served over the web ---
	# Defense-in-depth: markdown, dotfiles, lockfiles and repo config never belong
	# in dist/, but this guarantees a stray one can't leak. Human-readable
	# equivalents are published as .html pages (disclaimer.html, license.html).
	# NOTE: .mjs/.js are intentionally NOT blocked — the browser calculators/
	# verifiers legitimately load client-side modules (e.g. /cbam/lib/calculate.mjs).
	@blocked {
		path *.md .env* *.lock
		path /package.json /package-lock.json /Dockerfile* /LICENSE /LICENSE-* /DISCLAIMER* /DEPLOY* /.git*
	}
	respond @blocked 404

	handle /robots.txt {
		header Content-Type text/plain
		respond "User-agent: *
Allow: /
Sitemap: https://apis.allanninal.dev/dpp/sitemap.xml
Sitemap: https://apis.allanninal.dev/cbam/sitemap.xml
Sitemap: https://apis.allanninal.dev/c2pa/sitemap.xml
Sitemap: https://apis.allanninal.dev/eudr/sitemap.xml
" 200
	}

	# --- DPP (Digital Product Passport API) ---
	@dpp path /dpp/* /dpp
	handle @dpp {
		request_body {
			max_size 2MB
		}
		reverse_proxy shared-apisix:9080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# --- CBAM embedded-emissions API ---
	@cbam path /cbam/* /cbam
	handle @cbam {
		request_body {
			max_size 2MB
		}
		reverse_proxy shared-apisix:9080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# --- C2PA provenance API (sibling project on the same server) ---
	@c2pa path /c2pa/* /c2pa
	handle @c2pa {
		request_body {
			max_size 30MB
		}
		reverse_proxy shared-apisix:9080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# --- EUDR API (sibling project on the same server) ---
	@eudr path /eudr/* /eudr
	handle @eudr {
		request_body {
			max_size 2MB
		}
		reverse_proxy shared-apisix:9080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# HTML landing page at the bare root, linking all projects.
