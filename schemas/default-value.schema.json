{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apis.allanninal.dev/cbam/api/v1/schemas/default-value.schema.json",
  "title": "CBAM default embedded-emission values",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "effectiveDate", "values"],
  "properties": {
    "version": { "type": "string" },
    "source": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "effectiveDate": { "type": "string", "format": "date" },
    "note": { "type": "string" },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["good", "sector", "factor", "unit"],
        "properties": {
          "good": { "type": "string" },
          "sector": {
            "type": "string",
            "enum": ["iron-steel", "aluminium", "cement", "fertilisers", "hydrogen", "electricity"]
          },
          "factor": {
            "type": "number",
            "minimum": 0,
            "description": "Fallback default embedded-emission value for the good (tCO2e/t), used when no country-specific value applies. Corresponds to the rest-of-world / top-10-highest-emitters average in the binding methodology."
          },
          "unit": { "type": "string", "const": "tCO2e/t" },
          "byCountry": {
            "type": "object",
            "description": "Optional country-specific default values, keyed by ISO 3166-1 alpha-2 code. Overrides `factor` when the origin country matches.",
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
