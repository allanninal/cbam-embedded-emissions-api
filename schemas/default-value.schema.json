{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apis.allanninal.dev/cbam/api/v1/schemas/default-value.schema.json",
  "title": "CBAM default embedded-emission values",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "effectiveDate", "values"],
  "properties": {
    "version": { "type": "string" },
    "source": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "effectiveDate": { "type": "string", "format": "date" },
    "emissionsBasis": { "type": "string" },
    "keyedBy": { "type": "string" },
    "note": { "type": "string" },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cnCode", "good", "sector", "factor", "unit"],
        "properties": {
          "cnCode": { "type": "string", "pattern": "^[0-9]{4,10}$" },
          "good": { "type": "string" },
          "sector": {
            "type": "string",
            "enum": ["iron-steel", "aluminium", "cement", "fertilisers", "hydrogen", "electricity"]
          },
          "factor": {
            "type": "number",
            "minimum": 0,
            "description": "Good-level fallback default emissions (tCO2e/t) — the '_Other Countries and Territories' value in the binding workbook, used when no country-specific value applies."
          },
          "unit": { "type": "string", "const": "tCO2e/t" },
          "byCountry": {
            "type": "object",
            "description": "Country-specific default values keyed by ISO 3166-1 alpha-2 code; overrides `factor` for that origin.",
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
