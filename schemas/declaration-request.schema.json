{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apis.allanninal.dev/cbam/api/v1/schemas/declaration-request.schema.json",
  "title": "CBAM declaration request (bulk lines)",
  "type": "object",
  "additionalProperties": false,
  "required": ["lines"],
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cnCode", "originCountry", "tonnes"],
        "properties": {
          "lineId": { "type": ["string", "null"] },
          "cnCode": { "type": "string", "pattern": "^[0-9 .]{4,14}$" },
          "originCountry": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
          "tonnes": { "type": "number", "exclusiveMinimum": 0 },
          "carbonPrice": { "type": ["number", "null"], "exclusiveMinimum": 0 }
        }
      }
    },
    "importYear": { "type": "integer", "minimum": 2026, "maximum": 2100 }
  }
}
