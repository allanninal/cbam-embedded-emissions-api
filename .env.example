# Copy to .env on the server (never commit .env). docker compose reads it automatically.

# Redis password for the shared rate-limit store. Use a long random value, e.g.:
#   openssl rand -hex 24
# MUST match the shared stack's deploy/shared/.env (the same value the EUDR and
# C2PA projects use).
REDIS_PASSWORD=change-me-to-a-long-random-secret

# Public entry address for Caddy.
#   - Leave unset (or ":80") to serve HTTP on the bare IP (pre-domain).
#   - Set to a domain (e.g. apis.example.com) to enable automatic HTTPS
#     (Let's Encrypt) once DNS points at this server.
# SITE_ADDRESS=apis.example.com

# Scheduled EU ETS carbon-price refresh interval in milliseconds (0 disables).
# A production deployment wires a fetcher in carbon-price.mjs and sets e.g. 3600000
# (hourly). Left at 0, the cached data/carbon-price.json value is served and its
# freshness/stale flag is computed per request.
CARBON_PRICE_REFRESH_MS=0
